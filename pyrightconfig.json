{
  "pythonVersion": "3.10",
  "typeCheckingMode": "standard",
  "reportAny": "none",
  "venvPath": ".",
  "venv": ".venv",
  "include": [
    "src",
    "tools",
    "tests"
  ],
  "extraPaths": [
    "src",
    "tools"
  ],
  "exclude": [
    "**/__pycache__",
    "**/.venv",
    "dist",
    "tests/fixtures/generate_python"
  ]
}
